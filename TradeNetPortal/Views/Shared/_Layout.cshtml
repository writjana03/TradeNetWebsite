@{
    var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && 
                     ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | TradeNet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

</head>
<body>
   <nav class="navbar navbar-expand-lg fixed-top @(isHomePage ? "" : "navbar-solid")">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">TradeNet</a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Home")#home">Home</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Home")#about">About</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="@Url.Action("Index", "Home")#services">Services</a></li>

                @* Business Portal Menu - Show only when logged in *@
                @if (Context.Session.GetString("UserName") != null)
                {
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="BusinessPortal" asp-action="Profile">Profile</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="BusinessPortal" asp-action="LicenseList">Licenses</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="BusinessPortal" asp-action="Dashboard">Dashboard</a></li>

                    <li class="nav-item ms-lg-2">
                        <a class="nav-link position-relative" style="cursor: pointer;" onclick="toggleNotifications()">
                            <i class="fas fa-bell fa-lg"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationBadge" style="display:none;">
                                0
                            </span>
                        </a>
                    </li>

                    <li class="nav-item ms-lg-2">
                        <span class="nav-link text-primary fw-bold">
                            <i class="fas fa-user-circle me-1"></i> Hello, @Context.Session.GetString("UserName")
                        </span>
                    </li>

                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-outline-danger fw-600 rounded-pill px-4" asp-controller="Account" asp-action="Logout">Logout</a>
                    </li>
                }
                else
                {
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-primary fw-600 rounded-pill px-4 me-2" data-bs-toggle="modal" data-bs-target="#loginModal" style="cursor: pointer;">Login</a>
                        <a class="btn btn-primary fw-600 rounded-pill px-4" asp-controller="Account" asp-action="Register">Register</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Login Modal -->
    @await Html.PartialAsync("_LoginModal")

    <!-- Notifications Modal -->
    <div class="modal fade" id="notificationsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-bell"></i> Notifications
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="notificationsContent">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container text-center">
            <div class="mb-4">
                <img src="~/assets/logo.png" alt="Footer Logo" height="30" class="mb-3 opacity-75">
                <h5 class="fw-bold">TradeNet</h5>
                <p class="text-white-50 small">Empowering Commerce. Building Futures.</p>
            </div>
            <hr class="border-secondary">
            <p class="small text-white-50">&copy; 2026 TradeNet Government. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        var isHomePage = @(isHomePage.ToString().ToLower());

        window.onscroll = function () {
            var nav = document.querySelector('.navbar');
            // Only apply scroll effect on home page
            if (isHomePage) {
                if (window.pageYOffset > 50) {
                    nav.classList.add('navbar-scrolled');
                } else {
                    nav.classList.remove('navbar-scrolled');
                }
            }
        };

        function toggleNotifications() {
            $('#notificationsModal').modal('show');
            loadNotifications();
        }

        function loadNotifications() {
            $.get('/BusinessPortal/GetNotifications', function(data) {
                if (data && data.length > 0) {
                    var html = '<div class="list-group">';
                    data.forEach(function(notification) {
                        var isUnread = notification.status === 'Unread';
                        var bgClass = isUnread ? 'bg-light' : '';
                        var icon = getNotificationIcon(notification.category);

                        html += `
                            <div class="list-group-item ${bgClass}" onclick="markAsRead(${notification.notificationID})">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        <i class="${icon}"></i> ${notification.category}
                                        ${isUnread ? '<span class="badge bg-primary ms-2">New</span>' : ''}
                                    </h6>
                                    <small class="text-muted">${new Date(notification.createdDate).toLocaleString()}</small>
                                </div>
                                <p class="mb-1">${notification.message}</p>
                            </div>
                        `;
                    });
                    html += '</div>';
                    $('#notificationsContent').html(html);

                    var unreadCount = data.filter(n => n.status === 'Unread').length;
                    if (unreadCount > 0) {
                        $('#notificationBadge').text(unreadCount).show();
                    } else {
                        $('#notificationBadge').hide();
                    }
                } else {
                    $('#notificationsContent').html('<div class="text-center py-4 text-muted">No notifications</div>');
                    $('#notificationBadge').hide();
                }
            });
        }

        function getNotificationIcon(category) {
            switch(category) {
                case 'License': return 'fas fa-certificate text-primary';
                case 'Transaction': return 'fas fa-exchange-alt text-success';
                case 'Program': return 'fas fa-hand-holding-usd text-info';
                case 'Compliance': return 'fas fa-exclamation-triangle text-warning';
                default: return 'fas fa-bell text-secondary';
            }
        }

        function markAsRead(notificationId) {
            $.post('/BusinessPortal/MarkNotificationRead', { notificationId: notificationId }, function() {
                loadNotifications();
            });
        }

        $(document).ready(function() {
            // Check for new notifications every 30 seconds
            setInterval(function() {
                $.get('/BusinessPortal/GetNotifications', function(data) {
                    if (data && data.length > 0) {
                        var unreadCount = data.filter(n => n.status === 'Unread').length;
                        if (unreadCount > 0) {
                            $('#notificationBadge').text(unreadCount).show();
                        } else {
                            $('#notificationBadge').hide();
                        }
                    }
                });
            }, 30000);
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script> 
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>