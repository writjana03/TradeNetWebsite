<!-- Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-body p-5">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                
                <div class="text-center mb-4">
                    <div class="logo-placeholder mx-auto mb-3" style="width: 50px; height: 50px; background: linear-gradient(135deg, #003566, #001d3d); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.5rem;">
                        TN
                    </div>
                    <h4 class="fw-bold mb-2" style="color: #003566;">Trader Login</h4>
                    <p class="text-muted small">Access your TradeNet account</p>
                </div>
                
                <form method="post" asp-action="Login" asp-controller="Account">
                    <div class="mb-4">
                        <label for="modalEmail" class="form-label small fw-bold">Email Address</label>
                        <input type="email" name="email" id="modalEmail" class="form-control rounded-3 py-2" placeholder="your@email.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="modalPassword" class="form-label small fw-bold">Password</label>
                        <input type="password" name="password" id="modalPassword" class="form-control rounded-3 py-2" placeholder="Enter your password" required>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rememberMe" id="modalRememberMe">
                            <label class="form-check-label small" for="modalRememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold" style="background-color: #003566; border-color: #003566;">
                        Login
                    </button>
                </form>
                
                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">
                        Don't have an account? 
                        <a href="@Url.Action("Register", "Account")" class="fw-bold text-decoration-none" style="color: #003566;">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-content .form-control:focus {
        border-color: #003566;
        box-shadow: 0 0 0 0.2rem rgba(0, 53, 102, 0.15);
    }
    
    .modal-content .btn-primary:hover {
        background-color: #001d3d !important;
        border-color: #001d3d !important;
        transform: translateY(-2px);
    }
    
    .modal-content .form-check-input:checked {
        background-color: #003566;
        border-color: #003566;
    }
</style>
