@model TradeNetPortal.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-wrapper">
<div class="container mt-4">
    <h2>Trade Dashboard</h2>
    <p class="text-muted">Track your licenses, transactions, and available subsidies</p>
    <hr />

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6>Pending Licenses</h6>
                    <h2>@Model.PendingLicenses</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6>Approved Licenses</h6>
                    <h2>@Model.ApprovedLicenses</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h6>Pending Transactions</h6>
                    <h2>@Model.PendingTransactions</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h6>Total Value</h6>
                    <h2>$@Model.TotalTransactionAmount.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="licenses-tab" data-bs-toggle="tab" data-bs-target="#licenses" type="button" role="tab">
                <i class="fas fa-certificate"></i> Trade Licenses
            </button>
        </li> 
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactions" type="button" role="tab">
                <i class="fas fa-exchange-alt"></i> Transactions
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="subsidies-tab" data-bs-toggle="tab" data-bs-target="#subsidies" type="button" role="tab">
                <i class="fas fa-hand-holding-usd"></i> Available Subsidies
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dashboardTabContent">
        <!-- Trade Licenses Tab -->
        <div class="tab-pane fade show active" id="licenses" role="tabpanel">
            <div class="card mt-3">
                <div class="card-body">
                    <h5>My Trade Licenses</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Application Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AppliedLicenses.Any())
                                {
                                    foreach (var license in Model.AppliedLicenses)
                                    {
                                        <tr>
                                            <td>@license.Title</td>
                                            <td><span class="badge bg-info">@license.Type</span></td>
                                            <td>@license.ApplicationDate?.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @{
                                                    var statusClass = "bg-warning";
                                                    var statusText = license.ApplicationStatus ?? "Pending";

                                                    if (statusText == "Approved")
                                                    {
                                                        statusClass = "bg-success";
                                                    }
                                                    else if (statusText.Contains("Rejected"))
                                                    {
                                                        statusClass = "bg-danger";
                                                    }
                                                }
                                                <span class="badge @statusClass">@statusText</span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-info" onclick="viewLicenseFullDetails(@license.LicenseID)">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">No licenses applied yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transactions Tab -->
        <div class="tab-pane fade" id="transactions" role="tabpanel">
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5>Business Transactions</h5>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
                            <i class="fas fa-plus"></i> New Transaction
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Counterparty</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Transactions.Any())
                                {
                                    foreach (var transaction in Model.Transactions)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@transaction.Type</span></td>
                                            <td>$@transaction.Amount.ToString("N2")</td>
                                            <td>@transaction.Date.ToString("MMM dd, yyyy")</td>
                                            <td>@transaction.Counterparty</td>
                                            <td>
                                                @{
                                                    var txStatusClass = transaction.Status == "Completed" ? "bg-success" : 
                                                                        transaction.Status == "Failed" ? "bg-danger" : "bg-warning";
                                                }
                                                <span class="badge @txStatusClass">@transaction.Status</span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-info" onclick="viewTransactionFullDetails(@transaction.TransactionID)">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">No transactions recorded yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Subsidies Tab -->
        <div class="tab-pane fade" id="subsidies" role="tabpanel">
            <div class="card mt-3">
                <div class="card-body">
                    <h5>Available Subsidies & Programs</h5>
                    <div class="row mt-3">
                        @if (Model.AvailableSubsidies.Any())
                        {
                            foreach (var subsidy in Model.AvailableSubsidies)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card border-success">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0">@subsidy.Title</h6>
                                        </div>
                                        <div class="card-body">
                                            <p>@subsidy.Description.Substring(0, Math.Min(120, subsidy.Description.Length))...</p>
                                            <p><strong>Budget:</strong> $@subsidy.Budget.ToString("N0")</p>
                                            <p><strong>Type:</strong> @subsidy.ProgramType</p>
                                            <button class="btn btn-sm btn-info" onclick="viewProgramFullDetails(@subsidy.ProgramID)">
                                                <i class="fas fa-eye"></i> View Details
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">
                                <p class="text-center text-muted">No subsidies available at the moment.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Transaction Modal -->
<div class="modal fade" id="newTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Create New Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="newTransactionForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Transaction Type</label>
                        <select class="form-select" name="Type" required>
                            <option value="">Select Type</option>
                            <option value="Sale">Sale</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Export">Export</option>
                            <option value="Import">Import</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Amount ($)</label>
                        <input type="number" class="form-control" name="Amount" step="0.01" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Counterparty</label>
                        <input type="text" class="form-control" name="Counterparty" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Invoice Number (Optional)</label>
                        <input type="text" class="form-control" name="InvoiceNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea class="form-control" name="Description" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Transaction</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- License Details Modal -->
<div class="modal fade" id="licenseDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">License Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="licenseDetailsContent"></div>
        </div>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="modal fade" id="transactionDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="transactionDetailsContent"></div>
        </div>
    </div>
</div>

<!-- Program Details Modal -->
<div class="modal fade" id="programDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Program Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="programDetailsContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewLicenseFullDetails(licenseId) {
            $('#licenseDetailsModal').modal('show');
            $.get('/BusinessPortal/GetLicenseDetails?licenseId=' + licenseId, function(data) {
                var statusBadge = data.applicationStatus === 'Approved' ? 'success' : 
                                  data.applicationStatus && data.applicationStatus.includes('Rejected') ? 'danger' : 'warning';
                
                var html = `
                    <h5>${data.title}</h5>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Type:</strong> ${data.type}</p>
                            <p><strong>Application Date:</strong> ${data.applicationDate ? new Date(data.applicationDate).toLocaleDateString() : 'N/A'}</p>
                            <p><strong>Fee:</strong> $${data.fee}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Status:</strong> <span class="badge bg-${statusBadge}">${data.applicationStatus || 'Pending'}</span></p>
                            ${data.issuedDate ? `<p><strong>Issued Date:</strong> ${new Date(data.issuedDate).toLocaleDateString()}</p>` : ''}
                            ${data.expiryDate ? `<p><strong>Expiry Date:</strong> ${new Date(data.expiryDate).toLocaleDateString()}</p>` : ''}
                        </div>
                    </div>
                    <p><strong>Description:</strong> ${data.description}</p>
                    ${data.rejectionReason ? `<div class="alert alert-danger"><strong>Rejection Reason:</strong> ${data.rejectionReason}</div>` : ''}
                `;
                $('#licenseDetailsContent').html(html);
            });
        }

        function viewTransactionFullDetails(transactionId) {
            $('#transactionDetailsModal').modal('show');
            $.get('/BusinessPortal/GetTransactionDetails?transactionId=' + transactionId, function(data) {
                var statusBadge = data.status === 'Completed' ? 'success' : 
                                  data.status === 'Failed' ? 'danger' : 'warning';
                
                var html = `
                    <h5>Transaction #${data.transactionID}</h5>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Type:</strong> <span class="badge bg-secondary">${data.type}</span></p>
                            <p><strong>Amount:</strong> $${data.amount.toFixed(2)}</p>
                            <p><strong>Date:</strong> ${new Date(data.date).toLocaleDateString()}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Status:</strong> <span class="badge bg-${statusBadge}">${data.status}</span></p>
                            <p><strong>Counterparty:</strong> ${data.counterparty || 'N/A'}</p>
                            <p><strong>Invoice Number:</strong> ${data.invoiceNumber || 'N/A'}</p>
                        </div>
                    </div>
                    ${data.description ? `<p><strong>Description:</strong> ${data.description}</p>` : ''}
                `;
                $('#transactionDetailsContent').html(html);
            });
        }

        function viewProgramFullDetails(programId) {
            $('#programDetailsModal').modal('show');
            $.get('/BusinessPortal/GetProgramDetails?programId=' + programId, function(data) {
                var html = `
                    <h5>${data.title}</h5>
                    <hr />
                    <p><strong>Type:</strong> ${data.programType}</p>
                    <p><strong>Description:</strong> ${data.description}</p>
                    <p><strong>Budget:</strong> $${data.budget.toLocaleString()}</p>
                    <p><strong>Start Date:</strong> ${new Date(data.startDate).toLocaleDateString()}</p>
                    <p><strong>End Date:</strong> ${new Date(data.endDate).toLocaleDateString()}</p>
                    <p><strong>Eligibility Criteria:</strong> ${data.eligibilityCriteria}</p>
                    <p><strong>Status:</strong> <span class="badge bg-success">${data.status}</span></p>
                `;
                $('#programDetailsContent').html(html);
            });
        }

        $('#newTransactionForm').on('submit', function(e) {
            e.preventDefault();

            var formData = $(this).serialize();

            $.post('/BusinessPortal/CreateTransaction', formData, function(response) {
                if (response.success) {
                    alert(response.message);
                    $('#newTransactionModal').modal('hide');
                    location.reload();
                } else {
                    alert(response.message);
                }
            }).fail(function() {
                alert('An error occurred. Please try again.');
            });
        });
    </script>
}
</div>
