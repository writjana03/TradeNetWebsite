@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | TradeNet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --tn-blue: #003566;
            --tn-dark: #001d3d;
            --tn-light: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #333;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
        }

        .text-tn-blue {
            color: var(--tn-blue);
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .login-card {
            max-width: 500px;
            width: 100%;
        }

        .card {
            border-radius: 20px !important;
            border: none;
        }

        .form-control:focus {
            border-color: var(--tn-blue);
            box-shadow: 0 0 0 0.2rem rgba(0, 53, 102, 0.15);
        }

        .btn-primary {
            background-color: var(--tn-blue);
            border-color: var(--tn-blue);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--tn-dark);
            border-color: var(--tn-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 53, 102, 0.3);
        }

        .form-control {
            border: 1px solid #dee2e6;
            transition: border-color 0.2s ease;
        }

        .form-control:hover {
            border-color: #adb5bd;
        }

        .back-to-home {
            position: absolute;
            top: 20px;
            left: 20px;
            color: var(--tn-blue);
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .back-to-home:hover {
            color: var(--tn-dark);
            transform: translateX(-5px);
        }

        .logo-placeholder {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--tn-blue), var(--tn-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Index", "Home")" class="back-to-home">
        <i class="fas fa-arrow-left"></i> Back to Home
    </a>

    <div class="login-container">
        <div class="login-card">
            <div class="card shadow-lg p-5">
                <div class="text-center mb-5">
                    <div class="logo-placeholder">TN</div>
                    <h4 class="fw-bold text-tn-blue mb-2">Trader Login</h4>
                    <p class="text-muted small">Access your TradeNet account</p>
                </div>
                <form method="post" asp-action="Login" asp-controller="Account">
                    <div class="mb-4">
                        <label for="email" class="form-label small fw-bold">Email Address</label>
                        <input type="email" name="email" id="email" class="form-control rounded-3 py-2" placeholder="your@email.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label small fw-bold">Password</label>
                        <input type="password" name="password" id="password" class="form-control rounded-3 py-2" placeholder="Enter your password" required>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rememberMe" id="rememberMe">
                            <label class="form-check-label small" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold">Login</button>
                </form>
                <div class="text-center mt-5">
                    <p class="small text-muted">
                        Don't have an account? 
                        <a href="@Url.Action("Register", "Account")" class="text-tn-blue fw-bold text-decoration-none">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
