@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --tn-blue: #003566;
            --tn-dark: #001d3d;
            --tn-light: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #333;
        }

        /* --- Services Section Fixes --- */
        #services {
            background-color: #f0f4f8;
        }

        /* Specificity Fix: Ensuring hover and transitions work over Bootstrap defaults */
        #services .service-card {
            min-height: 400px;
            max-width: 340px;
            margin: 0 auto;
            border-radius: 18px !important;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            padding: 3rem 2rem !important;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
            border: none !important;
            text-align: center;
            cursor: pointer;
        }

        #services .service-card:hover {
            transform: translateY(-12px) !important;
            box-shadow: 0 20px 40px rgba(0, 53, 102, 0.15) !important;
        }

        .icon-box {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            flex-shrink: 0;
        }

        .icon-box i {
            font-size: 2.2rem !important;
        }

        /* Color Theme Enforcement */
        .card-blue {
            background-color: var(--tn-blue) !important;
            color: white !important;
        }

        .card-blue .icon-box { background: rgba(255, 255, 255, 0.15); }
        .card-blue i { color: #ffffff !important; }

        .card-white {
            background-color: #ffffff !important;
            color: var(--tn-dark) !important;
            border: 1px solid #eee !important;
        }

        .card-white .icon-box { background: rgba(0, 53, 102, 0.05); }
        .card-white i { color: var(--tn-blue) !important; }

        /* --- About Section & Hero --- */
        .hero-section {
            padding: 215px 0 165px;
            background: linear-gradient(rgba(0, 53, 102, 0.85), rgba(0, 53, 102, 0.85)),
                url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
        }

        .about-portal-card {
            background: #fff;
            padding: 2rem;
            border-radius: 12px;
            height: 100%;
            transition: transform 0.3s ease;
            border: 1px solid #f0f0f0;
            margin-top: 120px;
            text-align: center;
        }

        .circle-img-wrapper {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            overflow: hidden;
            margin: -120px auto 20px;
            border: 5px solid #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .circle-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    </style>
}

<section id="home" class="hero-section text-white text-center">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">Trade Without <span class="text-warning">Boundaries</span></h1>
        <p class="lead mb-5 opacity-75 mx-auto" style="max-width: 700px;">
            Streamlining business registration and global trade compliance through a unified digital gateway.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <button class="btn btn-success btn-lg px-5 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#loginModal">Apply Now</button>
            <button class="btn btn-outline-light btn-lg px-5 rounded-pill">View Guidelines</button>
        </div>
    </div>
</section>

<section id="about" class="py-5 my-5">
    <div class="container">
        <h2 class="fw-bold mb-5 text-center text-tn-blue">The Unified Gateway for National Trade Governance</h2>
         <p class="text-muted mb-4">TradeNet serves as the primary digital infrastructure for commerce

                        ministries and trade boards to regulate public trade, ensure policy compliance, and monitor

                        market activity. By integrating business registration, multi-tier trade licensing, and real-time

                        transaction tracking into a unified architecture, the platform establishes an immutable

                        environment for economic transparency. Designed for national scalability, TradeNet empowers

                        government agencies with data-driven oversight while providing a streamlined path for domestic

                        and international commerce.

                        environment.
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="about-portal-card shadow-sm">
                    <div class="circle-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=600" alt="Governance">
                    </div>
                    <h4 class="fw-bold text-tn-blue">Regulatory Oversight</h4>
                    <p class="text-muted small">Centralized workflows for validating trade licenses and enforcing national commerce policies.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="about-portal-card shadow-sm">
                    <div class="circle-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600" alt="Analytics">
                    </div>
                    <h4 class="fw-bold text-tn-blue">Market Intelligence</h4>
                    <p class="text-muted small">Real-time transaction tracking providing analytics on trade program efficiency.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="about-portal-card shadow-sm">
                    <div class="circle-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=600" alt="Compliance">
                    </div>
                    <h4 class="fw-bold text-tn-blue">Systemic Accountability</h4>
                    <p class="text-muted small">Immutable audit logs of all user actions to ensure 100% transparency.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="services" class="py-5">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-tn-blue display-5">WHAT WE OFFER</h2>
            <div class="mx-auto bg-primary" style="height: 4px; width: 60px; margin-top: 15px;"></div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-blue shadow-sm">
                    <div class="icon-box"><i class="fas fa-file-invoice"></i></div>
                    <h5 class="fw-bold">Quick Registration</h5>
                    <p>Complete your business setup in under 24 hours with our automated workflow.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-white shadow-sm">
                    <div class="icon-box"><i class="fas fa-shield-alt"></i></div>
                    <h5 class="fw-bold">Audit & Compliance</h5>
                    <p>Stay verified with our integrated compliance tracking and reporting system.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-blue shadow-sm">
                    <div class="icon-box"><i class="fas fa-chart-line"></i></div>
                    <h5 class="fw-bold">Trade Analytics</h5>
                    <p>Access real-time insights and market trends to grow your business internationally.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-white shadow-sm">
                    <div class="icon-box"><i class="fas fa-certificate"></i></div>
                    <h5 class="fw-bold">Digital Licensing</h5>
                    <p>Manage import/export permits through our secure digital vault.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-blue shadow-sm">
                    <div class="icon-box"><i class="fas fa-globe"></i></div>
                    <h5 class="fw-bold">Global Logistics</h5>
                    <p>Connect with verified shipping partners and track cargo across 150+ countries.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card service-card card-white shadow-sm">
                    <div class="icon-box"><i class="fas fa-credit-card"></i></div>
                    <h5 class="fw-bold">Secure Payments</h5>
                    <p>Facilitate cross-border transactions with government-backed escrow services.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="bg-dark text-white pt-5 pb-3">
    <div class="container text-center">
        <div class="mb-4">
            <img src="~/assets/logo.png" alt="Footer Logo" height="30" class="mb-3 opacity-75">
            <h5 class="fw-bold">TradeNet</h5>
            <p class="text-white-50 small">Empowering Commerce. Building Futures.</p>
        </div>
        <hr class="border-secondary">
        <p class="small text-white-50">&copy; 2026 TradeNet Government. All Rights Reserved.</p>
    </div>
</footer>

@section Scripts {
    <script>
        window.onscroll = function () {
            var nav = document.querySelector('.navbar');
            if (window.pageYOffset > 50) {
                nav.classList.add('navbar-scrolled');
            } else {
                nav.classList.remove('navbar-scrolled');
            }
        };
    </script>
}