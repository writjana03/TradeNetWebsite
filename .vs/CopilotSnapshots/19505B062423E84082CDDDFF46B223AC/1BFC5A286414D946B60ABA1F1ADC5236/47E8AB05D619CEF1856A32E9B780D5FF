@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | TradeNet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --tn-blue: #003566;
            --tn-dark: #001d3d;
            --tn-light: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #333;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
        }

        .text-tn-blue {
            color: var(--tn-blue);
        }

        .register-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .register-card {
            max-width: 700px;
            width: 100%;
        }

        .card {
            border-radius: 20px !important;
            border: none;
        }

        .form-control:focus {
            border-color: var(--tn-blue);
            box-shadow: 0 0 0 0.2rem rgba(0, 53, 102, 0.15);
        }

        .btn-primary {
            background-color: var(--tn-blue);
            border-color: var(--tn-blue);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--tn-dark);
            border-color: var(--tn-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 53, 102, 0.3);
        }

        .form-control {
            border: 1px solid #dee2e6;
            transition: border-color 0.2s ease;
        }

        .form-control:hover {
            border-color: #adb5bd;
        }

        .back-to-home {
            color: var(--tn-blue);
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            font-size: 0.875rem;
        }

        .back-to-home:hover {
            color: var(--tn-dark);
        }

        .logo-placeholder {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--tn-blue), var(--tn-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
        }

        .form-check-input:checked {
            background-color: var(--tn-blue);
            border-color: var(--tn-blue);
        }

        .password-strength {
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <div class="card shadow-lg p-5">
                <div class="text-center mb-5">
                    <div class="logo-placeholder">TN</div>
                    <h4 class="fw-bold text-tn-blue mb-2">Create Trader Account</h4>
                    <p class="text-muted small">Start your trade journey in seconds</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>@TempData["ErrorMessage"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>@TempData["SuccessMessage"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" asp-action="Register" asp-controller="Account">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="fullName" class="form-label small fw-bold">Full Name</label>
                            <input type="text" name="fullName" id="fullName" class="form-control rounded-3 py-2" placeholder="Enter your full name" required>
                        </div>
                        <div class="col-md-6">
                            <label for="businessName" class="form-label small fw-bold">Business Name</label>
                            <input type="text" name="businessName" id="businessName" class="form-control rounded-3 py-2" placeholder="Company Name e.g. ABC Ltd" required>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label for="email" class="form-label small fw-bold">Official Email</label>
                            <input type="email" name="email" id="email" class="form-control rounded-3 py-2" placeholder="work@company.com" required>
                        </div>
                        <div class="col-md-6">
                            <label for="password" class="form-label small fw-bold">Password</label>
                            <input type="password" name="password" id="password" class="form-control rounded-3 py-2" placeholder="Create a strong password" required minlength="6">
                            <div class="password-strength text-muted" id="passwordStrength"></div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <label for="confirmPassword" class="form-label small fw-bold">Confirm Password</label>
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control rounded-3 py-2" placeholder="Confirm your password" required>
                            <div class="invalid-feedback" id="passwordMismatch">Passwords do not match</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold mt-4">Register & Continue</button>
                </form>
                <div class="text-center mt-5">
                    <p class="small text-muted mb-3">
                        Already have an account? 
                        <a href="@Url.Action("Login", "Account")" class="text-tn-blue fw-bold text-decoration-none">Login here</a>
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="back-to-home">
                        <i class="fas fa-arrow-left"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Password confirmation validation
        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirmPassword');
        const passwordMismatch = document.getElementById('passwordMismatch');

        confirmPassword.addEventListener('input', function() {
            if (password.value !== confirmPassword.value) {
                confirmPassword.classList.add('is-invalid');
                passwordMismatch.style.display = 'block';
            } else {
                confirmPassword.classList.remove('is-invalid');
                passwordMismatch.style.display = 'none';
            }
        });

        // Form submission validation
        document.querySelector('form').addEventListener('submit', function(e) {
            if (password.value !== confirmPassword.value) {
                e.preventDefault();
                confirmPassword.classList.add('is-invalid');
                passwordMismatch.style.display = 'block';
            }
        });
    </script>
</body>
</html>
