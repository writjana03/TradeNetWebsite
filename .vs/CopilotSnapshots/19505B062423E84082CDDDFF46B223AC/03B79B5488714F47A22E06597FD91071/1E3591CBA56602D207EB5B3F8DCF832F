using Microsoft.AspNetCore.Mvc;
using TradeNetPortal.Services;

namespace TradeNetPortal.Controllers
{
    public class AccountController : Controller
    {
        private readonly InMemoryUserStore _userStore;

        public AccountController(InMemoryUserStore userStore)
        {
            _userStore = userStore;
        }

        public IActionResult Login()
        {
            return View();
        }

        [HttpPost]
        public IActionResult Login(string email, string password, bool rememberMe)
        {
            if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
            {
                TempData["ErrorMessage"] = "Email and password are required.";
                return View();
            }

            var user = _userStore.GetUserByEmail(email);

            if (user == null)
            {
                TempData["ErrorMessage"] = "User not registered. Please register first.";
                return View();
            }

            // In production, you should hash and compare passwords
            // For demo purposes, we'll use a simple check
            // TODO: Implement proper password hashing

            // Set session
            HttpContext.Session.SetInt32("UserId", user.UserID);
            HttpContext.Session.SetString("UserName", user.Name);
            HttpContext.Session.SetString("UserEmail", user.Email);

            TempData["SuccessMessage"] = $"Welcome back, {user.Name}!";

            // Redirect to Business Portal
            return RedirectToAction("Profile", "BusinessPortal");
        }

        public IActionResult Register()
        {
            return View();
        }

        [HttpPost]
        public IActionResult Register(string fullName, string businessName, string email, string password, string confirmPassword)
        {
            if (string.IsNullOrEmpty(fullName) || string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
            {
                TempData["ErrorMessage"] = "All fields are required.";
                return View();
            }

            if (password != confirmPassword)
            {
                TempData["ErrorMessage"] = "Passwords do not match.";
                return View();
            }

            // Check if user already exists
            var existingUser = _userStore.GetUserByEmail(email);
            if (existingUser != null)
            {
                TempData["ErrorMessage"] = "User with this email already exists.";
                return View();
            }

            // Create new user
            var newUser = _userStore.AddUser(fullName, email);

            // Create business profile if business name provided
            if (!string.IsNullOrEmpty(businessName))
            {
                _userStore.AddBusiness(newUser.UserID, businessName);
            }

            // Auto-login after registration
            HttpContext.Session.SetInt32("UserId", newUser.UserID);
            HttpContext.Session.SetString("UserName", newUser.Name);
            HttpContext.Session.SetString("UserEmail", newUser.Email);

            TempData["SuccessMessage"] = $"Registration successful! Welcome, {newUser.Name}!";

            // Redirect to Business Portal Profile page
            return RedirectToAction("Profile", "BusinessPortal");
        }

        public IActionResult Logout()
        {
            HttpContext.Session.Clear();
            TempData["SuccessMessage"] = "You have been logged out successfully.";
            return RedirectToAction("Index", "Home");
        }
    }
}
